# ============================================================================
# Mizys CRM — configuração do servidor
# Copie este arquivo para `.env` (na mesma pasta) e preencha.
# O `.env` NÃO vai para o git: ele tem chave e senha.
# ============================================================================

# ── Supabase (obrigatório) ──────────────────────────────────────────────────
# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de SERVIÇO (service_role). Ela ignora o Row Level Security, então só
# existe por um motivo: o link público de aceite, em que o cliente abre a
# proposta sem ter login no CRM. Sem esta chave o CRM funciona inteiro — só o
# link público fica desligado, e o /api/saude avisa.
# NUNCA coloque esta chave no navegador nem em repositório público.
SUPABASE_SERVICE_KEY=

# Rede com proxy que inspeciona o HTTPS (reassina os certificados) faz toda
# chamada ao Supabase falhar com CERTIFICATE_VERIFY_FAILED. Nesse caso, aponte
# aqui o pacote de CAs (.pem) do proxy.
# Em branco, o Python usa os certificados de sempre — que e o certo na maior
# parte das redes. Se existir certs/ca-bundle.pem, ele e usado sozinho.
SUPABASE_CA_BUNDLE=

# ── Servidor ────────────────────────────────────────────────────────────────
# Publicando na internet? Leia o docs/PUBLICAR.md antes: HOST=0.0.0.0 sem um
# proxy com HTTPS na frente expõe o CRM em texto puro.
PORT=5050
# 127.0.0.1 = só esta máquina. Para expor na rede interna use 0.0.0.0 — e leia
# antes a seção de segurança do README.
HOST=127.0.0.1
# Ligar o debug abre o console interativo do Werkzeug, que é execução remota de
# código para quem alcançar a porta. Deixe vazio, salvo depuração consciente.
FLASK_DEBUG=

# ── Conversão para PDF ──────────────────────────────────────────────────────
# O PDF da proposta é o PPTX exportado pelo LibreOffice em modo headless. Baixe
# em libreoffice.org; nenhuma configuração é necessária quando ele está
# instalado no lugar padrão (o servidor lê o caminho do registro do Windows).
#
# Só preencha se o LibreOffice estiver em pasta fora do comum ou for portátil.
# Aceita o executável ou a pasta program/:
#   C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# Motor da conversão:
#   libreoffice  (padrão)  o LibreOffice, e só ele
#   auto                   LibreOffice e, se falhar, o PowerPoint via COM
#   powerpoint             força o PowerPoint (Windows com Office instalado)
# O PowerPoint saiu do caminho padrão porque exige sessão interativa, briga com
# a instância aberta pelo usuário e deixa POWERPNT.exe pendurado quando falha.
PDF_MOTOR=libreoffice

# Segundos até desistir de uma conversão. A primeira é mais lenta: o LibreOffice
# ainda está criando o perfil que o servidor usa.
PDF_TIMEOUT=240

# ── Envio de e-mail (opcional) ──────────────────────────────────────────────
# Sem isto, o botão "Enviar por e-mail" explica o que falta em vez de falhar.
# A proposta sai do endereço comercial da empresa, não de um domínio de
# terceiro — é o que evita a caixa de spam do cliente.
#
# Hostinger (e-mail comprado junto com o domínio):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_USER=guilherme@seudominio.com   ← o endereço inteiro, não só o nome
#   SMTP_PASS=<a senha da CAIXA DE E-MAIL, não a do painel da Hostinger>
#   SMTP_FROM=guilherme@seudominio.com
# Microsoft 365:    smtp.office365.com   porta 587
# Google Workspace: smtp.gmail.com       porta 587  (use uma "senha de app")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 1 = STARTTLS (padrão nas portas 587/25). Na 465 o SSL é direto e isto é ignorado.
SMTP_TLS=1

# ── Prospeccao (opcional) ───────────────────────────────────────────────────
# Chave da Google Maps Platform para varrer o Maps por empresas. Exige, no
# projeto do Google Cloud: FATURAMENTO habilitado e a Places API (New) ativada.
# Chave de JavaScript restrita a referenciador nao serve — a chamada sai do
# servidor. Sem a chave, a tela de Prospeccao sobe com a busca desligada e a
# consulta por CNPJ funcionando.
GOOGLE_MAPS_API_KEY=
